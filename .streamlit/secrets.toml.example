# Copy into the Streamlit Cloud app's "Secrets" panel (or .streamlit/secrets.toml locally,
# which is git-ignored). Never commit real values.
T2S_EMBEDDED = "1"                     # run the pipeline inside Streamlit (no FastAPI backend)
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"   # e.g. a free Neon database

# Pick one provider:
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-20b"
GROQ_REASONING_EFFORT = "low"

# LLM_PROVIDER = "gemini"
# GEMINI_API_KEY = "..."
# GEMINI_API = "native"                # key sent as x-goog-api-key (normal for Streamlit Cloud)

LLM_FALLBACK = "none"
